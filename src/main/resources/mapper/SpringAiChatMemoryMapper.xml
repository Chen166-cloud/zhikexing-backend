<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chy.ai.mapper.SpringAiChatMemoryMapper">

    <!-- 根据会话id删除spring_ai_chat_memory表中的记录 -->
    <delete id="deleteByConversationId">
        DELETE FROM spring_ai_chat_memory
        WHERE conversation_id = #{conversationId}
    </delete>

    <!-- 根据会话id查询最早的USER消息内容，用于生成会话标题 -->
    <select id="findEarliestUserContentByConversationId" resultType="java.lang.String">
        SELECT content FROM spring_ai_chat_memory
        WHERE conversation_id = #{conversationId} AND type = 'USER'
        ORDER BY timestamp ASC
        LIMIT 1
    </select>

</mapper>
